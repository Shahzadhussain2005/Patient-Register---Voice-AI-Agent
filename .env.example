DATABASE_URL=sqlite:///./patients.db

# Phase 3 setup only: public HTTPS origin of your deployed FastAPI application.
BACKEND_PUBLIC_URL=https://YOUR_BACKEND_HOST
# Private key used only by the tool-registration snippet in the setup guide.
VAPI_PRIVATE_KEY=replace_with_your_private_vapi_key
# Save the assistant ID from the dashboard; the backend does not consume it.
VAPI_ASSISTANT_ID=replace_with_your_assistant_id
